{
    "deny": [
        "read(*mise.local.toml)",
        "read(.env)",
        "read(.env.*)",
        "read(*/.env)",
        "read(*/.env.*)",
        "read(*/auth.json)",
        "bash(* *mise.local.toml*)",
        "bash(* *auth.json*)",
        "bash(grep *)",
        "bash(egrep *)",
        "bash(fgrep *)",
        "bash(find * -exec *)",
        "bash(find * -execdir *)",
        "bash(find * -ok *)",
        "bash(find * -okdir *)",
        "bash(find * -delete*)",
        "bash(rg * --pre *)",
        "bash(rg * --pre=*)",
        "bash(rg --pre *)",
        "bash(rg --pre=*)"
    ],
    "ask": [
        "edit(.nono.json)",
        "edit(*/.nono.json)",
        "write(.nono.json)",
        "write(*/.nono.json)",
        "bash(* *.nono.json*)"
    ]
}
